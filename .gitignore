.ipynb_checkpoints/

# Mac OS-specific storage files
.DS_Store

# vim
*.swp
*.swo

# Mypy cache
.mypy_cache/

# Jupyter Book
_build/


# Project-specific ignores
# data files
data/
audio-data-collection/
OI-Submissions/

# Ignore PDFs, Word docs, and Google Docs in /docs
docs/*.pdf
docs/*.PDF
docs/*.doc
docs/*.docx
docs/*.gdoc

# Ignore Excel files and Google Sheets in /docs
docs/*.xls
docs/*.xlsx
docs/*.xlsm
docs/*.ods
docs/*.gsheet

# Ignore the entire models folder
models/

# Ignore all common image formats everywhere...
*.jpg
*.jpeg
*.png
*.gif
*.bmp
*.tiff
*.tif
*.svg
*.webp

# ...but allow images inside /docs/images/
!docs/images/
!docs/images/**

# Environments
.env